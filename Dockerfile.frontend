# Streamlit dashboard.
#
# Separate image from the backend so the two scale and deploy independently - the
# dashboard is stateless and cheap, the API holds the model in memory.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

# requirements.txt is exactly the dashboard's four packages - see that file.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY frontend/ ./frontend/

RUN useradd --create-home --uid 1000 hrai \
    && mkdir -p /app/data /app/models \
    && chown -R hrai:hrai /app
USER hrai

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"

CMD ["streamlit", "run", "frontend/streamlit_app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
